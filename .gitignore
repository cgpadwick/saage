# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Env / secrets
.env
*.local

# OS / editor
.DS_Store
.idea/
.vscode/

# cwe run artifacts (flows write outputs in-place)
flows/*/story.md
flows/*/review.md
flows/*/history.txt
flows/*/job_*.count

# diskcache / sqlite caches written at runtime in the CWD (e.g. mlebench,
# pulled in by the kaggle_solver flow, creates <cwd>/cache/cache.db)
cache/
*.db
*.sqlite
*.sqlite3
# run-derived kaggle_solver state: travels with the flow dir on disk (handoff
# ships the working tree, so remote runs still get it) but it is experiment
# output — never committed
flows/kaggle_solver/memory/
flows/kaggle_solver/benchmark_journal.jsonl
flows/kaggle_solver/BENCHMARK_RESULTS.md
